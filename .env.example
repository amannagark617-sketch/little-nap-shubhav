# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Comfort Advisor (optional) --------------------------------------------
# Leave every AI variable unset and the site works fully; the advisor simply
# does not appear.
#
# Option A — direct from the browser. This is how Google AI Studio runs an app.
# Simple, no backend, but the key ships inside the JavaScript bundle and anyone
# can read it. Only use a key you have restricted and quota-capped.
GEMINI_API_KEY=

# Option B — recommended for production. Point at your own endpoint, which
# holds the key server-side. See server/README.md for a ready-made function.
# When this is set, GEMINI_API_KEY is not needed in the build at all.
# VITE_AI_PROXY_URL=https://your-function-url/api/advisor

# Overrides the model. Defaults to gemini-2.5-flash.
# VITE_GEMINI_MODEL=gemini-2.5-flash

# --- Contact form (optional) -----------------------------------------------
# Any endpoint that accepts a JSON POST (Formspree, Basin, Web3Forms, your own).
# Unset, the form composes a pre-filled email instead, so it is never a dead end.
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx

# --- Hosting ---------------------------------------------------------------
# Only needed when serving from a sub-path, e.g. a GitHub Pages project site.
# VITE_BASE=/little-nap-shubhav/

# Set to 1 for hosts that cannot rewrite unknown paths to index.html. Routes
# become /#/products instead of /products, which works anywhere with no server
# configuration. Leave unset for Netlify, Vercel, Cloudflare and Cloud Run.
# VITE_HASH_ROUTER=1
